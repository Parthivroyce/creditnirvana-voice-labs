# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SARVAM_API_KEY: Optional. Sarvam AI subscription key for production Saari STT & Bulbul TTS.
# If omitted, CreditNirvana Voice Labs operates with high-fidelity browser speech engine
# and intelligent server-side conversational reasoning fallback with 100% functionality.
SARVAM_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000
